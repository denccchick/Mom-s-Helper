{
  "name": "moms-helper-frontend",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^1.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.momshelper.app",
    "productName": "Mom's Helper",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../MomsHelperBackend/dist/backend.exe",
        "to": "backend/backend.exe"
      },
      {
        "from": "../MomsHelperBackend/translation_models/",
        "to": "backend/translation_models/",
        "filter": ["**/*"]
      },
      {
        "from": "../MomsHelperBackend/easyocr_models/",
        "to": "backend/easyocr_models/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
